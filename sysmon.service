[Unit]
Description=sysmon - system resource & pressure monitor (observe, log, notify only)
Documentation=file:/usr/local/share/doc/sysmon/README.md
# Deliberately no dependency on the graphical session.
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sysmon daemon
Restart=always
RestartSec=5
Environment=MALLOC_ARENA_MAX=1 PYTHONDONTWRITEBYTECODE=1

# Stay responsive during a stall: higher CPU/IO priority, memory locked in RAM
# (mlockall in the program), and protected from the OOM killer. These settings
# affect ONLY this monitor process.
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
OOMScoreAdjust=-900
LimitMEMLOCK=infinity

# Resource limits for the monitor itself (cgroup v1 on Mint 20).
CPUQuota=10%
MemoryLimit=96M
TasksMax=16

# Directories (created by systemd, readable by all users).
RuntimeDirectory=sysmon
RuntimeDirectoryMode=0755
LogsDirectory=sysmon
LogsDirectoryMode=0755

# Sandboxing: read-only view of the system except its own directories.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
# Only what is needed: read other users' /proc/PID/io (SYS_PTRACE, DAC_*),
# lock memory (IPC_LOCK), read /dev/kmsg (SYSLOG), write to TTYs for optional wall.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_IPC_LOCK CAP_SYSLOG

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sysmon

[Install]
WantedBy=multi-user.target
