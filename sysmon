# Self-test: simulated scenarios (no real memory/CPU/I/O load is generated)
# --------------------------------------------------------------------------

class Sim:
    TOTAL = 63800.0

    def __init__(self, cfg):
        self.cfg = cfg
        self.ev = Evaluator(cfg, 20)
        self.p = Channel("pressure", cfg.f("general", "recovery_hold"), cfg.f("notify", "flap_guard"),
                         cfg.f("notify", "update_interval"))
        self.s = Channel("space", cfg.f("space", "recovery_hold"), 3600, 3600)
        self.t = 0.0
        self.events = []
        self.step = cfg.f("general", "interval")
        self.m = self.base()
        self.trace = []

    def base(self):
        m = {k: 0.0 for k in HIST_BASE_COLS if k not in ("time", "state", "space_state", "disk_dev")}
        m.update(mem_total_mb=self.TOTAL, mem_avail_mb=40000.0, anon_mb=20000.0, shmem_mb=2000.0, cache_mb=18000.0,
                 kernel_mb=2000.0, swap_total_mb=2048.0, swap_used_mb=0.0, oom_kills=0, procs_blocked=0,
                 load1=2.0, load5=2.0, load15=2.0, disk_dev="nvme0n1", ncpu=20,
                 fs={"/": {"pct": 89.0, "free_gb": 50.0, "size_gb": 457.0}})
        return m

    def run(self, seconds, mutate=None):
        end = self.t + seconds
        while self.t < end:
            self.t += self.step
            if mutate:
                mutate(self.t, self.m)
            self.m["mem_avail_pct"] = 100.0 * self.m["mem_avail_mb"] / self.TOTAL
            m = dict(self.m)
            pl, pr = self.ev.evaluate(m, self.t)
            sl, sr = self.ev.space(m, self.t)
            for kind, notify, keys in self.p.update(self.t, pl, pr):
                self.events.append((self.t, build_event(self.p, kind, notify, keys, pr, m, self.p)))
            for kind, notify, keys in self.s.update(self.t, sl, sr):
                self.events.append((self.t, build_event(self.s, kind, notify, keys, sr, m, self.s)))
            self.trace.append((self.t, m.get("mem_avail_mb"), m.get("eta_s"), self.p.state))
        return self

    def kinds(self, notified_only=False, channel=None):
        return [e["kind"] for _, e in self.events if (e["notify"] or not notified_only)
                and (channel is None or e["channel"] == channel) and e["kind"] != "DOWNGRADE"]

    def first(self, kind):
        for t, e in self.events:
            if e["kind"] == kind:
                return t, e
        return None, None


def cmd_selftest(args):
    cfg = Config(args.config)
    results = []

    def check(name, cond, detail=""):
        results.append((name, bool(cond), detail))

    def show(sim):
        if args.verbose:
            for t, e in sim.events:
                print("    t=%5.0fs %-8s %-9s notify=%-5s %s" % (t, e["channel"], e["kind"], e["notify"], e["title"]))
                if args.verbose > 1:
                    for b in e["body"].splitlines():
                        print("               " + b)

    # 1-2. Incident replay: steady RAM decline until exhaustion, at two speeds.
    for rate in (100.0, 25.0):
        sim = Sim(cfg)
        sim.run(60)

        def decline(t, m, rate=rate):
            m["mem_avail_mb"] = max(0.0, m["mem_avail_mb"] - rate * 5)
            m["anon_mb"] += rate * 5
            if m["mem_avail_mb"] < 0.05 * Sim.TOTAL:  # late phase: swap fills, PSI rises
                m["swap_used_mb"] = min(2048.0, m["swap_used_mb"] + 60 * 5)
                m["swapout_mb_s"] = 60.0
                m["psi_mem_some10"] = min(90.0, m["psi_mem_some10"] + 8)
                m["psi_mem_full10"] = min(70.0, m["psi_mem_full10"] + 5)

        t_ex = None
        while t_ex is None and sim.t < 4000:
            sim.run(5, decline)
            if sim.m["mem_avail_mb"] + (2048 - sim.m["swap_used_mb"]) <= 0.03 * Sim.TOTAL:
                t_ex = sim.t
        tw, ew = sim.first("WARNING")
        tc, ec = sim.first("CRITICAL")
        lead_w = (t_ex - tw) if tw is not None else None
        lead_c = (t_ex - tc) if tc is not None else None
        print("  scenario: RAM declining %.0f MB/s -> WARNING %s before exhaustion (\"%s\"), CRITICAL %s before" % (
            rate, fmt_dur(lead_w) if lead_w else "NEVER", ew["title"] if ew else "-",
            fmt_dur(lead_c) if lead_c else "NEVER"))
        show(sim)
        check("decline %.0f MB/s: WARNING >= 2 min before exhaustion" % rate, lead_w and lead_w >= 120,
              "lead %s" % lead_w)
        check("decline %.0f MB/s: CRITICAL >= 60 s before exhaustion" % rate, lead_c and lead_c >= 60,
              "lead %s" % lead_c)
        check("decline %.0f MB/s: CRITICAL body has memory breakdown" % rate,
              ec and "Shmem:" in ec["body"] and "Swap:" in ec["body"] and "Memory PSI" in ec["body"])
        check("decline %.0f MB/s: a notification mentions the prediction" % rate,
              any("predicted" in (e["title"] + e["body"]) for _, e in sim.events if e["notify"]))

    # 3. Short allocation spike: must not alert.
    sim = Sim(cfg)
    sim.m["mem_avail_mb"] = 15000.0
    sim.run(120)

    def spike(t, m):
        m["mem_avail_mb"] = 7000.0 if 125 <= t < 135 else 15000.0

    sim.run(200, spike)
    show(sim)
    check("10 s spike of -8 GB (avail 23% -> 11%): no alert", sim.kinds() == [], sim.kinds())

    # 4. Decline that stops: prediction disappears and state recovers.
    sim = Sim(cfg)
    sim.m["mem_avail_mb"] = 25000.0
    sim.run(100)

    def decline_then_flat(t, m):
        if m["mem_avail_mb"] > 12000:
            m["mem_avail_mb"] -= 60 * 5

    sim.run(900, decline_then_flat)
    show(sim)
    check("decline then stable: WARNING then RECOVERY, no CRITICAL",
          sim.kinds() == ["WARNING", "RECOVERY"], sim.kinds())
    check("decline then stable: prediction cleared at end", sim.trace[-1][2] is None)

    # 5. Memory + I/O pressure combination -> CRITICAL naming both.
    sim = Sim(cfg)
    sim.run(60)

    def mem_io(t, m):
        on = t < 360
        m["psi_mem_some10"] = 15.0 if on else 0.0
        m["psi_io_full10"] = 20.0 if on else 0.0

    sim.run(600, mem_io)
    show(sim)
    tc, ec = sim.first("CRITICAL")
    check("memory + I/O pressure: WARNING, CRITICAL, RECOVERY", sim.kinds(True) == ["WARNING", "CRITICAL", "RECOVERY"],
          sim.kinds(True))
    check("memory + I/O pressure: CRITICAL says 'memory + I/O'", ec and "memory + I/O" in ec["title"],
          ec and ec["title"])

    # 6. Sustained single-state condition: exactly one notification; flapping suppressed.
    sim = Sim(cfg)

    def psi_on(t, m):
        m["psi_mem_some10"] = 15.0

    def psi_off(t, m):
        m["psi_mem_some10"] = 0.0

    sim.run(600, psi_on).run(120, psi_off)
    n1 = sim.kinds(True)
    sim.run(120, psi_on).run(120, psi_off)
    n2 = sim.kinds(True)
    sim.run(400, psi_off).run(60, psi_on)
    n3 = sim.kinds(True)
    show(sim)
    check("10 min sustained WARNING: one WARNING + one RECOVERY notification", n1 == ["WARNING", "RECOVERY"], n1)
    check("re-WARNING within 5 min of recovery: not notified", n2 == n1, n2)
    check("WARNING after flap guard expired: notified again", n3 == n1 + ["WARNING"], n3)

    # 7. Already WARNING for low RAM, then prediction appears -> one UPDATE notification.
    sim = Sim(cfg)
    sim.m["mem_avail_mb"] = 0.13 * Sim.TOTAL
    sim.run(300)

    def slow_decline(t, m):
        m["mem_avail_mb"] -= 40 * 5

    sim.run(80, slow_decline)
    show(sim)
    tu, eu = sim.first("UPDATE")
    tc, _ = sim.first("CRITICAL")
    check("in WARNING (low RAM) then decline: UPDATE notification with prediction",
          eu and eu["notify"] and "predicted" in eu["title"] and (tc is None or tu < tc),
          eu and eu["title"])

    # 8. Disk space is an independent channel.
    sim = Sim(cfg)
    sim.m["fs"] = {"/": {"pct": 91.0, "free_gb": 41.0, "size_gb": 457.0},
                   "/boot/efi": {"pct": 2.0, "free_gb": 0.49, "size_gb": 0.5}}
    sim.run(60).run(60, psi_on)
    show(sim)
    check("disk space WARNING and memory WARNING both notified",
          sim.kinds(True, "space") == ["WARNING"] and sim.kinds(True, "pressure") == ["WARNING"],
          (sim.kinds(True, "space"), sim.kinds(True, "pressure")))
    check("small /boot/efi not flagged by GB rule",
          not any("/boot/efi" in json.dumps(e["reasons"]) for _, e in sim.events))

    # 9. OOM kill -> immediate CRITICAL.
    sim = Sim(cfg)
    sim.run(30)
    sim.run(5, lambda t, m: m.update(oom_kills=1))
    sim.run(5, lambda t, m: m.update(oom_kills=0))
    show(sim)
    check("OOM kill: immediate CRITICAL", sim.kinds()[:1] == ["CRITICAL"], sim.kinds())

    # 10. CPU-only saturation -> WARNING, not CRITICAL.
    sim = Sim(cfg)
    sim.run(300, lambda t, m: m.update(psi_cpu_some60=60.0, psi_cpu_some10=60.0, load1=25.0, cpu_pct=99.0))
    show(sim)
    check("CPU busy alone (PSI 60%, load 25/20): WARNING only", sim.kinds() == ["WARNING"], sim.kinds())

    # 11. Severe I/O stall alone -> CRITICAL.
    sim = Sim(cfg)
    sim.run(120, lambda t, m: m.update(psi_io_full10=55.0, psi_io_some10=80.0, procs_blocked=20,
                                       iowait_pct=35.0, disk_util=100.0))
    show(sim)
    tc, ec = sim.first("CRITICAL")
    check("I/O stall (PSI full 55%, 20 blocked): CRITICAL", ec is not None, sim.kinds())

    print()
    fails = 0
    for name, ok, detail in results:
        print("  %s  %s%s" % ("PASS" if ok else "FAIL", name, "" if ok else "   -> %s" % (detail,)))
        fails += not ok
    print("\n%d/%d checks passed" % (len(results) - fails, len(results)))
    return 1 if fails else 0


