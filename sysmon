def main():
    if os.path.basename(sys.argv[0]) == "sysmon-status" and (len(sys.argv) == 1 or sys.argv[1].startswith("-")):
        sys.argv.insert(1, "status")
    ap = argparse.ArgumentParser(prog="sysmon", description="System resource & pressure monitor (observe/notify only)")
    ap.add_argument("--config", default=CONF_PATH)
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("daemon")
    p.add_argument("--dir", help="history directory (default from config)")
    p.add_argument("--run-dir", help="runtime directory (default /run/sysmon)")
    p.add_argument("--no-mlock", action="store_true")
    p.add_argument("--duration", type=float, default=0, help="stop after N seconds (testing)")
    p = sub.add_parser("notify")
    p.add_argument("--run-dir")
    p.add_argument("--poll", type=float, default=2.0)
    p.add_argument("--test", action="store_true", help="send one test notification and exit")
    p = sub.add_parser("status")
    p.add_argument("--run-dir")
    p = sub.add_parser("history", help="table of recorded samples")
    p.add_argument("--since", help="HH:MM, 'YYYY-MM-DD HH:MM', or 30m / 2h ago (default 15m)")
    p.add_argument("--until")
    p.add_argument("--every", type=int, default=1, help="show every Nth sample")
    p.add_argument("--csv", action="store_true", help="raw CSV output (all columns)")
    p.add_argument("--dir")
    p = sub.add_parser("events")
    p.add_argument("-n", type=int, default=30)
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--dir")
    p = sub.add_parser("snapshots")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--dir")
    p = sub.add_parser("snapshot")
    p.add_argument("--run-dir")
    sub.add_parser("config")
    p = sub.add_parser("selftest")
    p.add_argument("-v", "--verbose", action="count", default=0)
    args = ap.parse_args()
    if args.cmd == "daemon":
        cfg = Config(args.config)
        cfg.validate()
        Daemon(cfg, args).run()
        return 0
    handlers = {"notify": cmd_notify, "status": cmd_status, "history": cmd_history, "events": cmd_events,
                "snapshots": cmd_snapshots, "snapshot": cmd_snapshot, "config": cmd_config,
                "selftest": cmd_selftest}
    if args.cmd not in handlers:
        ap.print_help()
        return 1
    return handlers[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main() or 0)
