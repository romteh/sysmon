def cmd_status(args):
    path = os.path.join(args.run_dir or RUN_DIR, "state.json")
    try:
        with open(path) as f:
            st = json.load(f)
    except (OSError, ValueError):
        print("sysmon: no state file at %s - is the service running? (systemctl status sysmon)" % path)
        return 1
    m = st["metrics"]
    age = time.time() - st["ts"]
    print("sysmon %s   pressure: %s   disk space: %s%s" % (
        st["time"], st["pressure"], st["space"],
        "   (STALE: %s old - daemon stalled or stopped?)" % fmt_dur(age) if age > 30 else ""))
    print("Memory  available %s (%.1f%%) | anon %s | shmem %s | cache %s | kernel %s" % (
        gb(m["mem_avail_mb"]), m["mem_avail_pct"], gb(m["anon_mb"]), gb(m["shmem_mb"]), gb(m["cache_mb"]),
        gb(m["kernel_mb"])))
    slope = m.get("mem_slope_mb_s")
    print("        swap %.2f/%.2f GB | in %.1f / out %.1f MB/s | refaults %.0f/s | major faults %.0f/s" % (
        m["swap_used_mb"] / 1024, m["swap_total_mb"] / 1024, m["swapin_mb_s"], m["swapout_mb_s"],
        m["refault_s"], m["majflt_s"]))
    print("        trend %s MB/s | predicted exhaustion: %s" % (
        "%+.1f" % slope if slope is not None else "(warming up)",
        fmt_eta(m.get("eta_s")) if m.get("eta_s") is not None else "none"))
    print("PSI     memory some %.1f full %.1f | io some %.1f full %.1f | cpu some %.1f   (avg10 %%)" % (
        m["psi_mem_some10"], m["psi_mem_full10"], m["psi_io_some10"], m["psi_io_full10"], m["psi_cpu_some10"]))
    print("CPU     %.1f%% busy | iowait %.1f%% | load %.2f %.2f %.2f on %d CPUs | blocked tasks %d" % (
        m["cpu_pct"], m["iowait_pct"], m["load1"], m["load5"], m["load15"], m["ncpu"], m["procs_blocked"]))
    for name, d in sorted(st.get("disks", {}).items()):
        print("Disk    %s util %.0f%% | read %.1f write %.1f MB/s | await %.1f ms" % (
            name, d["util"], d["r_mb_s"], d["w_mb_s"], d["await_ms"]))
    fs = m.get("fs") or {}
    print("Space   " + " | ".join("%s %.1f%% (%.1f GB free)" % (mp, v["pct"], v["free_gb"])
                                  for mp, v in fs.items() if v))
    if st["reasons"]:
        print("Active signals:")
        for k, (lvl, cat, msg) in st["reasons"].items():
            print("  [%s] %s" % (lvl, msg))
    else:
        print("Active signals: none")
    return 0


def parse_when(s, default):
    if not s:
        return default
    s = s.strip()
    now = time.time()
    rel = s.lstrip("-")
    if rel[:-1].replace(".", "", 1).isdigit() and rel[-1] in "smhd":
        mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}[rel[-1]]
        return now - float(rel[:-1]) * mult
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return time.mktime(time.strptime(s, fmt))
        except ValueError:
            pass
    for fmt in ("%H:%M:%S", "%H:%M"):
        try:
            t = time.strptime(s, fmt)
            d = datetime.datetime.now().replace(hour=t.tm_hour, minute=t.tm_min, second=t.tm_sec, microsecond=0)
            ts = d.timestamp()
            return ts - 86400 if ts > now + 60 else ts
        except ValueError:
            pass
    raise SystemExit("cannot parse time: %r (use HH:MM, 'YYYY-MM-DD HH:MM' or 30m/2h)" % s)


def cmd_history(args):
    cfg = Config(args.config)
    d = args.dir or cfg.s("history", "dir")
    since = parse_when(args.since, time.time() - 900)
    until = parse_when(args.until, time.time() + 1)
    files = sorted(glob.glob(os.path.join(d, "history-*.csv")))
    rows = []
    for p in files:
        try:
            stamp = os.path.basename(p)[8:19]
            fstart = time.mktime(time.strptime(stamp, "%Y%m%d-%H"))
        except ValueError:
            continue
        if fstart > until or fstart + 3600 * 2 < since:
            continue
        with open(p, newline="") as f:
            for r in csv.DictReader(f):
                try:
                    e = float(r["epoch"])
                except (ValueError, KeyError, TypeError):
                    continue
                if since <= e <= until:
                    rows.append(r)
    rows.sort(key=lambda r: float(r["epoch"]))
    if args.every > 1:
        rows = rows[::args.every]
    if args.csv:
        if rows:
            w = csv.DictWriter(sys.stdout, fieldnames=list(rows[0].keys()))
            w.writeheader()
            w.writerows(rows)
        return 0
    if not rows:
        print("no samples in %s .. %s (history dir %s)" % (now_str(since), now_str(until), d))
        return 1

    def g(r, k, scale=1.0, fmt="%.1f"):
        v = r.get(k)
        if v in (None, ""):
            return "-"
        try:
            return fmt % (float(v) * scale)
        except ValueError:
            return v

    cols = [("time", 8), ("state", 4), ("availG", 6), ("anonG", 6), ("shmG", 5), ("cacheG", 6), ("swapG", 5),
            ("swpo/s", 6), ("rflt/s", 6), ("mPSI", 5), ("mFul", 5), ("ioFul", 5), ("cpu%", 5), ("iow%", 4),
            ("load1", 5), ("blk", 3), ("util", 4), ("eta", 6), ("dt", 4)]
    print(" ".join("%*s" % (wd, n) for n, wd in cols) + "  signals")
    last_day = None
    for r in rows:
        day = r["time"][:10]
        if day != last_day:
            print("--- %s ---" % day)
            last_day = day
        eta = r.get("eta_s")
        vals = [r["time"][11:19], r["state"][:4], g(r, "mem_avail_mb", 1 / 1024.0), g(r, "anon_mb", 1 / 1024.0),
                g(r, "shmem_mb", 1 / 1024.0), g(r, "cache_mb", 1 / 1024.0), g(r, "swap_used_mb", 1 / 1024.0, "%.2f"),
                g(r, "swapout_mb_s"), g(r, "refault_s", 1, "%.0f"), g(r, "psi_mem_some10"), g(r, "psi_mem_full10"),
                g(r, "psi_io_full10"), g(r, "cpu_pct", 1, "%.0f"), g(r, "iowait_pct", 1, "%.0f"), g(r, "load1"),
                g(r, "procs_blocked", 1, "%.0f"), g(r, "disk_util", 1, "%.0f"),
                fmt_eta(float(eta)) if eta not in (None, "") else "-", g(r, "interval_s", 1, "%.0f")]
        print(" ".join("%*s" % (wd, v) for (n, wd), v in zip(cols, vals)) + "  " + r.get("reasons", ""))
    return 0


def cmd_events(args):
    cfg = Config(args.config)
    d = args.dir or cfg.s("history", "dir")
    lines = []
    for p in (os.path.join(d, "events.log.1"), os.path.join(d, "events.log")):
        try:
            with open(p) as f:
                lines += f.readlines()
        except OSError:
            pass
    if not lines:
        print("no events recorded yet")
        return 0
    for line in lines[-args.n:]:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        flag = "" if ev.get("notify") else "  (not notified: anti-flap)"
        print("%s  %-8s %-9s %s%s" % (ev["time"], ev["channel"], ev["kind"], ev["title"], flag))
        if args.verbose:
            for b in ev.get("body", "").splitlines():
                print("      " + b)
    return 0


def cmd_snapshots(args):
    cfg = Config(args.config)
    d = os.path.join(args.dir or cfg.s("history", "dir"), "snapshots")
    files = sorted(glob.glob(os.path.join(d, "*.txt")))
    for p in files[-args.n:]:
        print("%8.1f KB  %s" % (os.path.getsize(p) / 1024.0, p))
    if not files:
        print("no snapshots in %s" % d)
    return 0


def cmd_snapshot(args):
    try:
        with open(os.path.join(args.run_dir or RUN_DIR, "sysmon.pid")) as f:
            pid = int(f.read())
        os.kill(pid, signal.SIGUSR1)
    except PermissionError:
        print("permission denied: run with sudo")
        return 1
    except (OSError, ValueError) as e:
        print("cannot signal daemon: %s" % e)
        return 1
    print("snapshot requested; see `sysmon snapshots` in a few seconds")
    return 0


def cmd_config(args):
    cfg = Config(args.config)
    try:
        cfg.validate()
    except ValueError as e:
        print("INVALID value: %s" % e)
        return 1
    print("# effective configuration (%s)" % (cfg.loaded[0] if cfg.loaded else "built-in defaults"))
    for u in cfg.unknown:
        print("# WARNING: unknown option ignored: %s" % u)
    for sec in cfg.cp.sections():
        print("[%s]" % sec)
        for k, v in cfg.cp.items(sec):
            print("%s = %s" % (k, v))
    return 0


