def _escape(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def send_notification(title, body, urgency="normal"):
    icon = {"critical": "dialog-error", "normal": "dialog-warning", "low": "dialog-information"}.get(urgency)
    try:
        r = subprocess.run(["notify-send", "-u", urgency, "-a", "sysmon", "-i", icon,
                            _escape(title), _escape(body)], timeout=15,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        return r.returncode == 0
    except Exception:
        return False


def cmd_notify(args):
    run_dir = args.run_dir or RUN_DIR
    if args.test:
        ok = send_notification("sysmon test notification",
                               "If you can read this, desktop notifications work.\n"
                               "CRITICAL alerts use critical urgency and stay on screen.", "normal")
        print("sent" if ok else "notify-send failed")
        return 0 if ok else 1
    path = os.path.join(run_dir, "events.jsonl")
    cursor = time.time() - 60
    sig = None
    daemon_down_notified = False
    print("sysmon notifier watching %s" % path, flush=True)
    while True:
        try:
            st = os.stat(path)
            s = (st.st_ino, st.st_size, st.st_mtime)
        except OSError:
            s = None
        if s and s != sig:
            sig = s
            try:
                with open(path) as f:
                    lines = f.readlines()
            except OSError:
                lines = []
            for line in lines:
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                if ev.get("ts", 0) <= cursor:
                    continue
                cursor = ev["ts"]
                if ev.get("notify"):
                    ok = send_notification(ev["title"], ev["body"], ev.get("urgency", "normal"))
                    print("%s %s %s" % (ev.get("time"), "sent" if ok else "FAILED", ev["title"]), flush=True)
        # watchdog: tell the user if the monitor itself stopped updating
        try:
            age = time.time() - os.stat(os.path.join(run_dir, "state.json")).st_mtime
        except OSError:
            age = 1e9
        if age > 120 and not daemon_down_notified:
            daemon_down_notified = True
            send_notification("sysmon is not running",
                              "The monitor has not updated its state for %s.\n"
                              "Check: systemctl status sysmon" % (fmt_dur(age) if age < 1e8 else "a long time"),
                              "normal")
        elif age < 30 and daemon_down_notified:
            daemon_down_notified = False
        time.sleep(args.poll)


