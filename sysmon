# --------------------------------------------------------------------------
# Configuration
# --------------------------------------------------------------------------

class Config:
    def __init__(self, path=CONF_PATH):
        self.cp = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
        self.cp.read_string(DEFAULTS_INI)
        self.path = path
        self.loaded = []
        self.unknown = []
        if path and os.path.exists(path):
            user = configparser.ConfigParser(inline_comment_prefixes=("#", ";"))
            user.read(path)
            for sec in user.sections():
                for key, val in user.items(sec, raw=True):
                    if not self.cp.has_option(sec, key):
                        self.unknown.append("%s.%s" % (sec, key))
                        continue
                    self.cp.set(sec, key, val)
            self.loaded = [path]

    def f(self, sec, key):
        return self.cp.getfloat(sec, key)

    def i(self, sec, key):
        return int(self.cp.getfloat(sec, key))

    def b(self, sec, key):
        return self.cp.getboolean(sec, key)

    def s(self, sec, key):
        return self.cp.get(sec, key).strip()

    def lst(self, sec, key):
        return [x.strip() for x in self.s(sec, key).split(",") if x.strip()]

    def validate(self):
        """Raise ValueError if any value is not parseable."""
        for sec in self.cp.sections():
            for key, val in self.cp.items(sec):
                if key in ("disks", "filesystems", "dir"):
                    continue
                if val.lower() in ("yes", "no", "true", "false", "on", "off"):
                    continue
                float(val)


# --------------------------------------------------------------------------
# Small helpers
