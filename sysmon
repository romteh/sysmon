def round_m(v):
    if isinstance(v, float):
        return round(v, 2)
    return v


class Daemon:
    def __init__(self, cfg, args):
        self.cfg = cfg
        self.args = args
        self.hist_dir = args.dir or cfg.s("history", "dir")
        self.snap_dir = os.path.join(self.hist_dir, "snapshots")
        self.run_dir = args.run_dir or RUN_DIR
        self.stop = threading.Event()
        self.force_snapshot = False
        self.collector = Collector(cfg)
        self.ev = Evaluator(cfg, self.collector.ncpu)
        self.pressure = Channel("pressure", cfg.f("general", "recovery_hold"), cfg.f("notify", "flap_guard"),
                                cfg.f("notify", "update_interval"))
        self.space = Channel("space", cfg.f("space", "recovery_hold"), 3600, 3600)
        self.columns = HIST_BASE_COLS + sum(
            [["fs_%s_pct" % fs_key(mp), "fs_%s_free_gb" % fs_key(mp)] for mp in self.collector.filesystems], []
        ) + ["reasons"]
        self.kmsg = KmsgReader()
        self.recent = collections.deque(maxlen=36)
        self.emit_lock = threading.Lock()
        self.snap_q = queue.Queue(4)
        self.snap_busy_since = None
        self.last_periodic = -1e18

    def log(self, prio, text):
        self.journal.put((prio, text))

    # ---- event emission ----
    def emit(self, ev):
        line = json.dumps(ev, ensure_ascii=False)
        with self.emit_lock:
            path = os.path.join(self.run_dir, "events.jsonl")
            try:
                if os.path.exists(path) and os.path.getsize(path) > 256 * 1024:
                    with open(path) as f:
                        keep = f.readlines()[-200:]
                    tmp = path + ".tmp"
                    with open(tmp, "w") as f:
                        f.writelines(keep)
                    os.chmod(tmp, 0o644)
                    os.replace(tmp, path)
                with open(path, "a") as f:
                    f.write(line + "\n")
                os.chmod(path, 0o644)
            except OSError as e:
                self.log(3, "cannot write %s: %s" % (path, e))
        self.store.put(("event", line + "\n"))
        prio = {"CRITICAL": 2, "WARNING": 4, "UPDATE": 4, "RECOVERY": 5}.get(ev["kind"], 6)
        self.log(prio, "%s [%s] %s | %s%s" % (ev["kind"], ev["channel"], ev["title"],
                                             ev["body"].replace("\n", "; "),
                                             "" if ev["notify"] else " (notification suppressed: anti-flap)"))
        if ev["kind"] == "CRITICAL" and ev["notify"] and self.cfg.b("notify", "wall_on_critical"):
            msg = "sysmon %s\n%s\n%s" % (ev["time"], ev["title"], ev["body"])
            threading.Thread(target=self._wall, args=(msg,), daemon=True).start()

    @staticmethod
    def _wall(msg):
        try:
            subprocess.run(["wall"], input=msg.encode(), timeout=30,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception:
            pass

    def dispatch(self, ev, m, reasons):
        job = {"event": ev, "m": dict(m), "reasons": dict(reasons), "state": ev["state"],
               "kmsg": list(self.kmsg.ring), "recent": list(self.recent), "label": ev["kind"]}
        stuck = self.snap_busy_since is not None and time.monotonic() - self.snap_busy_since > 30
        wants_snapshot = ev["kind"] in ("WARNING", "CRITICAL", "UPDATE")
        if wants_snapshot and not stuck and self.snap_q.empty():
            try:
                self.snap_q.put_nowait(job)
                return
            except queue.Full:
                pass
        self.emit(ev)  # emit directly (no enrichment)
        if wants_snapshot and not stuck:
            job["event"] = None
            try:
                self.snap_q.put_nowait(job)
            except queue.Full:
                pass

    # ---- snapshot worker ----
    def snapshot_worker(self):
        while True:
            job = self.snap_q.get()
            if job is None:
                return
            self.snap_busy_since = time.monotonic()
            try:
                self.take_snapshot(job)
            except Exception as e:
                self.log(3, "snapshot failed: %r" % (e,))
                if job.get("event"):
                    self.emit(job["event"])
            finally:
                self.snap_busy_since = None

    def take_snapshot(self, job):
        n = self.cfg.i("snapshots", "top_n")
        t1 = time.monotonic()
        p1 = scan_processes(full=True)
        time.sleep(1.0)
        t2 = time.monotonic()
        p2 = scan_processes(full=False)
        dt = max(1e-3, t2 - t1)
        for pid, p in p2.items():
            q = p1.get(pid)
            if q and q["start"] == p["start"]:
                p["cpu_pct"] = 100.0 * (p["cpu"] - q["cpu"]) / CLK_TCK / dt
                p["io_r"] = (p.get("read_bytes", 0) - q.get("read_bytes", 0)) / dt
                p["io_w"] = (p.get("write_bytes", 0) - q.get("write_bytes", 0)) / dt
                for k in ("anon_kb", "shmem_kb", "swap_kb", "user"):
                    if k in q:
                        p[k] = q[k]
        m = job["m"]
        ev = job.get("event")
        apps = top_apps(p1)
        top_cpu = sorted((p for p in p2.values() if "cpu_pct" in p), key=lambda p: -p["cpu_pct"])[:n]
        top_io = sorted((p for p in p2.values() if "io_r" in p), key=lambda p: -(p["io_r"] + p["io_w"]))[:n]
        if ev is not None:
            cats = set(r[1] for r in job["reasons"].values())
            extra = []
            if "memory" in cats or not cats:
                extra.append("Top memory: " + ", ".join("%s %s" % (c, gb(kb / 1024.0)) for c, kb in apps[:3]))
            if "io" in cats:
                extra.append("Top I/O: " + ", ".join("%s %.0f MB/s" % (p["comm"], (p["io_r"] + p["io_w"]) / MB)
                                                     for p in top_io[:3] if p["io_r"] + p["io_w"] > 0) or "-")
            if "cpu" in cats:
                extra.append("Top CPU: " + ", ".join("%s %.0f%%" % (p["comm"], p["cpu_pct"]) for p in top_cpu[:3]))
            if extra:
                ev["body"] = ev["body"] + "\n\n" + "\n".join(extra)
            self.emit(ev)

        if fs_free_mb(self.hist_dir) < self.cfg.f("history", "min_fs_free_mb"):
            self.log(4, "snapshot skipped: low free space on log filesystem")
            return
        top_rss = sorted(p1.values(), key=lambda p: -(p.get("anon_kb", p["rss_kb"]) + p.get("shmem_kb", 0)))[:n]
        top_swap = sorted((p for p in p1.values() if p.get("swap_kb")), key=lambda p: -p["swap_kb"])[:10]
        dtasks = d_state_tasks(p2)
        cmd = read_cmdlines([p["pid"] for p in top_rss + top_cpu + top_io][:3 * n])
        states = collections.Counter(p["state"] for p in p2.values())
        L = []
        w = L.append
        w("sysmon snapshot  %s  (%s)" % (now_str(), job["label"]))
        w("host %s  kernel %s  uptime %s" % (socket.gethostname(), os.uname().release,
                                              fmt_dur(float(read_text("/proc/uptime").split()[0]))))
        w("pressure state: %s   space state: %s" % (LEVEL_NAMES[self.pressure.state], LEVEL_NAMES[self.space.state]))
        w("")
        w("== Active signals ==")
        for k in ordered_keys(job["reasons"]):
            lvl, cat, msg = job["reasons"][k]
            w("  [%s] %-10s %s" % (LEVEL_NAMES[lvl], k, msg))
        if not job["reasons"]:
            w("  (none)")
        w("")
        w("== Memory ==")
        for line in mem_block(m):
            w("  " + line)
        w("  Total %s | free %s | dirty %.0f MB | writeback %.0f MB | slab unreclaimable %.0f MB" % (
            gb(m["mem_total_mb"]), gb(m["mem_free_mb"]), m["dirty_mb"], m["writeback_mb"], m["slab_unrecl_mb"]))
        w("  rates: swap-in %.1f MB/s, swap-out %.1f MB/s, major faults %.0f/s, refaults %.0f/s, "
          "direct-reclaim stalls %.0f/s, pgscan_direct %.0f/s, OOM kills %d" % (
              m["swapin_mb_s"], m["swapout_mb_s"], m["majflt_s"], m["refault_s"], m["allocstall_s"],
              m["pgscan_direct_s"], m["oom_kills"]))
        slope = m.get("mem_slope_mb_s")
        w("  trend: headroom %s, slope %s MB/s, predicted exhaustion %s" % (
            gb(m.get("headroom_mb", 0)), "%.1f" % slope if slope is not None else "-", fmt_eta(m.get("eta_s"))))
        tf = tmpfs_usage()
        if tf:
            w("  tmpfs usage: " + ", ".join("%s %s" % (mp, gb(u / MB)) for u, mp in tf[:8]))
        shm = sysv_shm()
        if shm:
            w("  SysV shm: %d segments, %s resident" % (len(shm), gb(sum(r[0] for r in shm) / MB)))
        w("")
        w("== Pressure (PSI avg10 / avg60, %; interval = measured over last sample) ==")
        for res in ("mem", "io", "cpu"):
            w("  %-4s some %5.1f / %5.1f   full %5.1f / %5.1f   interval some %5.1f" % (
                res, m["psi_%s_some10" % res], m["psi_%s_some60" % res], m["psi_%s_full10" % res],
                m["psi_%s_full60" % res], m["psi_%s_some_int" % res]))
        w("")
        w("== CPU / load ==")
        w("  CPU %.1f%%  iowait %.1f%%  steal %.1f%%  load %.2f %.2f %.2f on %d CPUs" % (
            m["cpu_pct"], m["iowait_pct"], m["steal_pct"], m["load1"], m["load5"], m["load15"], m["ncpu"]))
        w("  procs_running %d  procs_blocked %d  processes %d  threads %d  states %s" % (
            m["procs_running"], m["procs_blocked"], len(p2), m["threads_total"],
            " ".join("%s=%d" % kv for kv in sorted(states.items()))))
        w("")
        w("== Disks ==")
        for name, d in sorted(m.get("disks", {}).items()):
            w("  %-10s util %5.1f%%  read %7.1f MB/s  write %7.1f MB/s  await %6.1f ms  in-flight %d" % (
                name, d["util"], d["r_mb_s"], d["w_mb_s"], d["await_ms"], d["inflight"]))
        for mp, v in sorted((m.get("fs") or {}).items()):
            if v:
                w("  fs %-10s %5.1f%% used, %.1f GB free of %.1f GB" % (mp, v["pct"], v["free_gb"], v["size_gb"]))
        w("")
        w("== Top memory by application (anon RSS + swap, summed per name) ==")
        for c, kb in top_apps(p1, n):
            w("  %9s  %s" % (gb(kb / 1024.0), c))
        w("")
        w("== Top %d processes by memory ==" % n)
        w("  %7s %-10s %9s %9s %9s %9s  %s" % ("PID", "USER", "ANON", "SHMEM", "SWAP", "RSS", "COMMAND"))
        for p in top_rss:
            w("  %7d %-10s %8.0fM %8.0fM %8.0fM %8.0fM  %s" % (
                p["pid"], p.get("user", "?")[:10], p.get("anon_kb", 0) / 1024.0, p.get("shmem_kb", 0) / 1024.0,
                p.get("swap_kb", 0) / 1024.0, p["rss_kb"] / 1024.0, cmd.get(p["pid"]) or p["comm"]))
        if top_swap:
            w("")
            w("== Top swap users ==")
            for p in top_swap:
                w("  %7d %8.0fM  %s" % (p["pid"], p["swap_kb"] / 1024.0, p["comm"]))
        w("")
        w("== Top %d processes by CPU (measured over 1 s) ==" % n)
        for p in top_cpu:
            w("  %7d %6.1f%%  state %s  threads %4d  %s" % (
                p["pid"], p["cpu_pct"], p["state"], p["threads"], cmd.get(p["pid"]) or p["comm"]))
        w("")
        w("== Top %d processes by disk I/O (measured over 1 s) ==" % n)
        if os.geteuid() != 0:
            w("  (not root: only own processes visible)")
        for p in top_io:
            if p["io_r"] + p["io_w"] <= 0:
                continue
            w("  %7d  read %7.1f MB/s  write %7.1f MB/s  %s" % (
                p["pid"], p["io_r"] / MB, p["io_w"] / MB, cmd.get(p["pid"]) or p["comm"]))
        w("")
        w("== Tasks in D state (uninterruptible): %d ==" % len(dtasks))
        for pid, tid, tcomm, pcomm, wchan in dtasks:
            w("  pid %7d tid %7d  %-16s (%s)  wchan=%s" % (pid, tid, tcomm, pcomm, wchan))
        w("")
        w("== Recent samples (oldest first) ==")
        w("  %-8s %8s %8s %8s %7s %6s %6s %6s %6s %5s %5s %6s" % (
            "time", "availMB", "swapMB", "swpoMB/s", "reflt/s", "mPSI", "mFULL", "ioFULL", "cpu%", "iow%",
            "blk", "eta"))
        for r in job["recent"]:
            w("  %-8s %8.0f %8.0f %8.1f %7.0f %6.1f %6.1f %6.1f %6.1f %5.1f %5d %6s" % (
                time.strftime("%H:%M:%S", time.localtime(r["epoch"])), r["mem_avail_mb"], r["swap_used_mb"],
                r["swapout_mb_s"], r["refault_s"], r["psi_mem_some10"], r["psi_mem_full10"], r["psi_io_full10"],
                r["cpu_pct"], r["iowait_pct"], r["procs_blocked"], fmt_eta(r.get("eta_s"))))
        w("")
        w("== Kernel warnings (recent, from /dev/kmsg) ==")
        for line in job["kmsg"][-80:] or ["  (none since monitor start)"]:
            w("  " + line)
        w("")
        w("== Raw /proc/meminfo ==")
        try:
            w(read_text("/proc/meminfo").rstrip())
        except OSError:
            pass
        w("")
        w("== Selected /proc/vmstat counters ==")
        try:
            for line in read_text("/proc/vmstat").splitlines():
                if line.startswith(("pswp", "pgmajfault", "pgscan", "pgsteal", "allocstall", "workingset",
                                    "oom_kill", "compact_stall", "nr_dirty", "nr_writeback", "thp_fault",
                                    "nr_shmem", "nr_anon", "nr_file_pages", "nr_free_pages")):
                    w("  " + line)
        except OSError:
            pass
        w("")
        w("== Raw PSI / loadavg / diskstats ==")
        for res in ("memory", "io", "cpu"):
            try:
                for line in read_text("/proc/pressure/" + res).splitlines():
                    w("  %-6s %s" % (res, line))
            except OSError:
                pass
        try:
            w("  loadavg " + read_text("/proc/loadavg").strip())
            for line in read_text("/proc/diskstats").splitlines():
                if line.split()[2] in self.collector.disks:
                    w("  " + line.strip())
        except OSError:
            pass
        text = "\n".join(L) + "\n"
        os.makedirs(self.snap_dir, exist_ok=True)
        path = os.path.join(self.snap_dir, "%s-%s.txt" % (time.strftime("%Y%m%d-%H%M%S"), job["label"]))
        with open(path, "w") as f:
            f.write(text)
            f.flush()
            os.fdatasync(f.fileno())
        self.log(6, "snapshot written: %s" % path)
        self.cleanup_snapshots()

    def cleanup_snapshots(self):
        files = sorted(glob.glob(os.path.join(self.snap_dir, "*.txt")))
        sizes = []
        for p in files:
            try:
                sizes.append((p, os.path.getsize(p)))
            except OSError:
                pass
        total = sum(s for _, s in sizes)
        maxf = self.cfg.i("snapshots", "max_files")
        maxb = self.cfg.f("snapshots", "max_total_mb") * MB
        while sizes and (len(sizes) > maxf or total > maxb):
            p, s = sizes.pop(0)
            try:
                os.unlink(p)
            except OSError:
                pass
            total -= s

    # ---- main loop ----
    def write_state(self, m, preason, sreason):
        st = {"ts": time.time(), "time": now_str(), "pid": os.getpid(), "version": VERSION,
              "pressure": LEVEL_NAMES[self.pressure.state], "space": LEVEL_NAMES[self.space.state],
              "reasons": {k: [LEVEL_NAMES[v[0]], v[1], v[2]] for k, v in list(preason.items()) + list(sreason.items())},
              "metrics": {k: round_m(v) for k, v in m.items() if k not in ("disks",)},
              "disks": m.get("disks", {}), "dropped": self.store_sink.dropped}
        path = os.path.join(self.run_dir, "state.json")
        tmp = path + ".tmp"
        try:
            with open(tmp, "w") as f:
                json.dump(st, f)
            os.chmod(tmp, 0o644)
            os.replace(tmp, path)
        except OSError:
            pass

    def history_line(self, m, preason, sreason):
        row = dict(m)
        row["time"] = now_str(m["epoch"])
        row["epoch"] = int(m["epoch"])
        row["state"] = LEVEL_NAMES[self.pressure.state]
        row["space_state"] = LEVEL_NAMES[self.space.state]
        row["reasons"] = "|".join(ordered_keys(dict(list(preason.items()) + list(sreason.items()))))
        return ",".join(fmt_num(round_m(row.get(c))) for c in self.columns) + "\n"

    def run(self):
        threading.stack_size(512 * 1024)
        os.makedirs(self.run_dir, exist_ok=True)
        os.makedirs(self.hist_dir, exist_ok=True)
        self.journal = AsyncSink("journal", journal_handler, 1000)
        self.journal.start()
        hs = HistoryStore(self.cfg, self.hist_dir, self.columns, self.journal)
        self.store_sink = AsyncSink("history", hs.handle, 5000)
        self.store = self.store_sink
        self.store_sink.start()
        self.store.put(("cleanup",))
        threading.Thread(target=self.snapshot_worker, name="snapshot", daemon=True).start()

        locked = "no"
        if not self.args.no_mlock:
            try:
                libc = ctypes.CDLL(None, use_errno=True)
                if libc.mlockall(1 | 2) == 0:  # MCL_CURRENT | MCL_FUTURE
                    locked = "yes"
                else:
                    locked = "failed (errno %d)" % ctypes.get_errno()
            except Exception as e:
                locked = "failed (%s)" % e
        with open(os.path.join(self.run_dir, "sysmon.pid"), "w") as f:
            f.write(str(os.getpid()))
        signal.signal(signal.SIGTERM, lambda *a: self.stop.set())
        signal.signal(signal.SIGINT, lambda *a: self.stop.set())
        signal.signal(signal.SIGUSR1, lambda *a: setattr(self, "force_snapshot", True))
        psi_ok = os.path.exists("/proc/pressure/memory")
        self.log(6, "sysmon %s started: interval %ss, disks %s, filesystems %s, PSI %s, mlock %s, config %s, history %s" % (
            VERSION, fmt_num(self.cfg.f("general", "interval")), ",".join(self.collector.disks),
            ",".join(self.collector.filesystems), "available" if psi_ok else "NOT AVAILABLE", locked,
            self.cfg.loaded[0] if self.cfg.loaded else "defaults", self.hist_dir))
        for u in self.cfg.unknown:
            self.log(4, "unknown config option ignored: %s" % u)

        interval = self.cfg.f("general", "interval")
        crit_iv = self.cfg.f("snapshots", "critical_interval")
        started = time.monotonic()
        self.collector.sample()  # prime deltas
        next_t = time.monotonic() + interval
        last_cleanup = time.monotonic()
        while not self.stop.is_set():
            delay = next_t - time.monotonic()
            if delay > 0 and self.stop.wait(delay):
                break
            now = time.monotonic()
            next_t += interval
            if next_t < now:
                next_t = now + interval
            try:
                self.tick(now, interval, crit_iv)
            except Exception as e:
                self.log(3, "sample failed: %r" % (e,))
            if now - last_cleanup > 3600:
                last_cleanup = now
                self.store.put(("cleanup",))
            if self.args.duration and now - started >= self.args.duration:
                break
        self.log(6, "sysmon stopping")
        time.sleep(0.3)

    def tick(self, now, interval, crit_iv):
        m = self.collector.sample()
        if m is None:
            return
        if m["interval_s"] > 3 * interval:
            self.log(4, "sampling was delayed: %.1f s since previous sample (system stall?)" % m["interval_s"])
        self.kmsg.drain()
        plevel, preason = self.ev.evaluate(m, now)
        slevel, sreason = self.ev.space(m, now)
        events = []
        for kind, notify, keys in self.pressure.update(now, plevel, preason):
            events.append(build_event(self.pressure, kind, notify, keys, preason, m, self.pressure))
        for kind, notify, keys in self.space.update(now, slevel, sreason):
            events.append(build_event(self.space, kind, notify, keys, sreason, m, self.space))
        self.recent.append({k: m.get(k) for k in (
            "epoch", "mem_avail_mb", "swap_used_mb", "swapout_mb_s", "refault_s", "psi_mem_some10",
            "psi_mem_full10", "psi_io_full10", "cpu_pct", "iowait_pct", "procs_blocked", "eta_s")})
        for ev in events:
            if ev["kind"] == "DOWNGRADE":
                self.log(5, "pressure downgraded to WARNING")
                continue
            self.dispatch(ev, m, preason if ev["channel"] == "pressure" else sreason)
            if ev["kind"] == "CRITICAL":
                self.last_periodic = now
        if self.pressure.state == 2 and now - self.last_periodic >= crit_iv:
            self.last_periodic = now
            self._queue_snapshot(m, preason, "CRITICAL-periodic")
        if self.force_snapshot:
            self.force_snapshot = False
            self._queue_snapshot(m, preason, "manual")
        self.write_state(m, preason, sreason)
        self.store.put(("hist", m["epoch"], self.history_line(m, preason, sreason)))

    def _queue_snapshot(self, m, reasons, label):
        try:
            self.snap_q.put_nowait({"event": None, "m": dict(m), "reasons": dict(reasons), "label": label,
                                    "kmsg": list(self.kmsg.ring), "recent": list(self.recent),
                                    "state": LEVEL_NAMES[self.pressure.state]})
        except queue.Full:
            pass


