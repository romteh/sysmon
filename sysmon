# Kernel log reader (/dev/kmsg, non-blocking, no fork)
# --------------------------------------------------------------------------

KMSG_KEYWORDS = ("oom", "out of memory", "hung_task", "blocked for more than", "i/o error",
                 "soft lockup", "hard lockup", "ext4-fs error", "nvme", "page allocation failure",
                 "call trace", "rcu_sched", "watchdog")


class KmsgReader:
    def __init__(self):
        self.fd = None
        self.ring = collections.deque(maxlen=300)
        try:
            self.fd = os.open("/dev/kmsg", os.O_RDONLY | os.O_NONBLOCK)
            os.lseek(self.fd, 0, os.SEEK_END)
        except OSError:
            self.fd = None

    def drain(self):
        if self.fd is None:
            return
        for _ in range(2000):
            try:
                rec = os.read(self.fd, 8192)
            except BlockingIOError:
                return
            except BrokenPipeError:
                continue  # records overwritten; continue with next
            except OSError:
                return
            if not rec:
                return
            line = rec.decode("utf-8", "replace").split("\n", 1)[0]
            head, _, msg = line.partition(";")
            try:
                pri = int(head.split(",")[0]) & 7
            except ValueError:
                pri = 6
            low = msg.lower()
            if pri <= 4 or any(k in low for k in KMSG_KEYWORDS):
                self.ring.append("%s <%d> %s" % (now_str(), pri, msg[:300]))


