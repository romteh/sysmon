class AsyncSink(threading.Thread):
    def __init__(self, name, handler, maxsize=5000):
        super().__init__(name=name, daemon=True)
        self.q = queue.Queue(maxsize)
        self.handler = handler
        self.dropped = 0
        self.errors = 0

    def put(self, item):
        try:
            self.q.put_nowait(item)
        except queue.Full:
            self.dropped += 1

    def run(self):
        while True:
            item = self.q.get()
            if item is None:
                return
            try:
                self.handler(item)
            except Exception:
                self.errors += 1


def journal_handler(item):
    prio, text = item
    sys.stdout.write("<%d>%s\n" % (prio, text))
    sys.stdout.flush()


def fs_free_mb(path):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize / MB
    except OSError:
        return 1e12


class HistoryStore:
    """Hourly CSV files + events.log, with retention, size cap and disk-free guard."""

    def __init__(self, cfg, directory, columns, journal):
        self.cfg = cfg
        self.dir = directory
        self.columns = columns
        self.header = ",".join(columns) + "\n"
        self.journal = journal
        self.cur_name = None
        self.f = None
        self.space_checked = -1e9
        self.space_ok_cached = True
        os.makedirs(self.dir, exist_ok=True)

    def space_ok(self):
        now = time.monotonic()
        if now - self.space_checked > 60:
            self.space_checked = now
            ok = fs_free_mb(self.dir) >= self.cfg.f("history", "min_fs_free_mb")
            if ok != self.space_ok_cached:
                self.journal.put((4, "history writing %s (filesystem free space %s min_fs_free_mb)" % (
                    "resumed" if ok else "PAUSED", "above" if ok else "below")))
            self.space_ok_cached = ok
        return self.space_ok_cached

    def handle(self, item):
        if item[0] == "hist":
            self.write_hist(item[1], item[2])
        elif item[0] == "event":
            self.write_event(item[1])
        elif item[0] == "cleanup":
            self.cleanup()

    def _open(self, base):
        n = 0
        while True:
            name = base + (".%d" % n if n else "") + ".csv"
            path = os.path.join(self.dir, name)
            if not os.path.exists(path) or os.path.getsize(path) == 0:
                break
            with open(path) as f:
                if f.readline() == self.header:
                    break
            n += 1
        f = open(path, "a")
        if f.tell() == 0:
            f.write(self.header)
        return name, f

    def write_hist(self, epoch, line):
        if not self.space_ok():
            return
        base = "history-" + time.strftime("%Y%m%d-%H", time.localtime(epoch))
        if self.cur_name is None or not self.cur_name.startswith(base):
            if self.f:
                self.f.close()
            self.cur_name, self.f = self._open(base)
            self.cleanup()
        self.f.write(line)
        self.f.flush()
        os.fdatasync(self.f.fileno())

    def write_event(self, line):
        if not self.space_ok():
            return
        path = os.path.join(self.dir, "events.log")
        try:
            if os.path.getsize(path) > 5 * MB:
                os.replace(path, path + ".1")
        except OSError:
            pass
        with open(path, "a") as f:
            f.write(line)
            f.flush()
            os.fdatasync(f.fileno())

    def cleanup(self):
        files = sorted(glob.glob(os.path.join(self.dir, "history-*.csv")))
        cutoff = time.time() - self.cfg.f("history", "retention_days") * 86400
        cur = os.path.join(self.dir, self.cur_name) if self.cur_name else None
        keep = []
        for p in files:
            try:
                if os.path.getmtime(p) < cutoff and p != cur:
                    os.unlink(p)
                    continue
                keep.append((p, os.path.getsize(p)))
            except OSError:
                pass
        total = sum(s for _, s in keep)
        limit = self.cfg.f("history", "max_total_mb") * MB
        for p, s in keep:
            if total <= limit:
                break
            if p == cur:
                continue
            try:
                os.unlink(p)
                total -= s
            except OSError:
                pass


