def mem_block(m):
    lines = [
        "Available: %s (%.1f%%)" % (gb(m["mem_avail_mb"]), m["mem_avail_pct"]),
        "Anonymous: %s" % gb(m["anon_mb"]),
        "Shmem: %s" % gb(m["shmem_mb"]),
        "Page cache: %s" % gb(m["cache_mb"]),
        "Kernel: %s" % gb(m["kernel_mb"]),
        "Swap: %.2f/%.2f GB" % (m["swap_used_mb"] / 1024, m["swap_total_mb"] / 1024),
        "Swap-in/out: %.1f / %.1f MB/s" % (m["swapin_mb_s"], m["swapout_mb_s"]),
        "Memory PSI: %.0f%% (full %.0f%%)" % (m["psi_mem_some10"], m["psi_mem_full10"]),
    ]
    if m.get("eta_s") is not None:
        lines.append("Predicted exhaustion: %s" % fmt_eta(m["eta_s"]))
    return lines


def io_block(m):
    return ["I/O PSI: full %.0f%%, some %.0f%%" % (m["psi_io_full10"], m["psi_io_some10"]),
            "iowait: %.0f%%, disk %s util: %.0f%%, await %.0f ms" % (
                m["iowait_pct"], m["disk_dev"], m["disk_util"], m["disk_await_ms"]),
            "Blocked tasks (D): %d" % m["procs_blocked"]]


def cpu_block(m):
    return ["CPU: %.0f%% busy, PSI some %.0f%% (60 s %.0f%%), load %.1f/%.1f/%.1f on %d CPUs" % (
        m["cpu_pct"], m["psi_cpu_some10"], m["psi_cpu_some60"], m["load1"], m["load5"], m["load15"], m["ncpu"])]


def build_event(channel, kind, notify, keys, reasons, m, ch):
    ts = time.time()
    ev = {"ts": ts, "time": now_str(ts), "channel": channel.name, "kind": kind, "notify": notify,
          "state": LEVEL_NAMES[channel.state],
          "reasons": {k: reasons[k][2] for k in ordered_keys(reasons)}}
    shown = [k for k in ordered_keys(reasons) if k in keys] if kind == "UPDATE" else ordered_keys(reasons)
    msgs = [reasons[k][2] for k in shown]
    cats = set(r[1] for r in reasons.values())
    if channel.name == "space":
        if kind == "RECOVERY":
            ev.update(title="Disk space OK again", body="All monitored filesystems are below the warning level.",
                      urgency="low")
        else:
            first = msgs[0] if msgs else "disk space"
            ev.update(title="Disk space %s: %s" % (kind if kind != "UPDATE" else "WARNING", first.split(" (")[0]),
                      body="\n".join(msgs), urgency="critical" if kind == "CRITICAL" else "normal")
        return ev
    if kind == "RECOVERY":
        dur = (ch.last_recovery - ch.ep_start) if ch.ep_start is not None else 0
        ev.update(title="RECOVERY: system resources back to normal",
                  body="Pressure episode lasted %s, peak level %s.\nDetails: sysmon events / sysmon history" % (
                      fmt_dur(dur), LEVEL_NAMES[ch.ep_peak]),
                  urgency="low")
        return ev
    if kind == "CRITICAL":
        if "combo" in reasons:
            head = "system stall risk - " + reasons["combo"][2]
        elif "oom" in reasons:
            head = "kernel OOM killer activated"
        elif "memory" in cats:
            head = "severe memory pressure"
        elif "io" in cats:
            head = "disk I/O saturation"
        else:
            head = "CPU saturation"
        title = "CRITICAL: " + head
        urgency = "critical"
    else:
        lead = msgs[0].split(" (")[0].split(":")[0] if msgs else "resource pressure"
        title = ("WARNING (update): " if kind == "UPDATE" else "WARNING: ") + lead
        urgency = "normal"
    body = [x for x in msgs if x and not x.startswith("combined pressure")][:4]
    if "memory" in cats:
        body += [""] + mem_block(m)
    if "io" in cats:
        body += [""] + io_block(m)
    if "cpu" in cats:
        body += [""] + cpu_block(m)
    ev.update(title=title, body="\n".join(body).strip(), urgency=urgency)
    return ev


