# Rule evaluation
# --------------------------------------------------------------------------

class Debounce:
    def __init__(self):
        self.w_since = None
        self.c_since = None

    def update(self, raw, now, warn_hold, crit_hold):
        if raw >= 1:
            if self.w_since is None:
                self.w_since = now
        else:
            self.w_since = None
        if raw >= 2:
            if self.c_since is None:
                self.c_since = now
        else:
            self.c_since = None
        if raw >= 2 and now - self.c_since >= crit_hold:
            return 2
        if raw >= 1 and now - self.w_since >= warn_hold:
            return 1
        return 0


# Display priority of reasons (first = most important)
PRIORITY = ["oom", "combo", "mem_trend", "mem_psi", "swap", "reclaim", "mem_avail",
            "io_psi", "io_blocked", "disk_util", "cpu_psi", "cpu_load"]
CAT_NAMES = {"memory": "memory", "io": "I/O", "cpu": "CPU"}


class Evaluator:
    def __init__(self, cfg, ncpu):
        self.cfg = cfg
        self.ncpu = ncpu
        self.trend = Trend(cfg)
        c = cfg
        # key, category, function, warn_hold, crit_hold
        self.rules = [
            ("mem_trend", "memory", self.r_trend, c.f("trend", "warn_hold"), c.f("trend", "crit_hold")),
            ("mem_psi", "memory", self.r_mem_psi, c.f("memory", "psi_some_warn_hold"), c.f("memory", "psi_crit_hold")),
            ("mem_avail", "memory", self.r_mem_avail, c.f("memory", "avail_warn_hold"), c.f("memory", "avail_crit_hold")),
            ("swap", "memory", self.r_swap, c.f("swap", "warn_hold"), c.f("swap", "crit_hold")),
            ("reclaim", "memory", self.r_reclaim, c.f("reclaim", "warn_hold"), 0),
            ("oom", "memory", self.r_oom, 0, 0),
            ("io_psi", "io", self.r_io_psi, c.f("io", "psi_warn_hold"), c.f("io", "psi_crit_hold")),
            ("io_blocked", "io", self.r_blocked, c.f("io", "blocked_warn_hold"), c.f("io", "blocked_crit_hold")),
            ("disk_util", "io", self.r_disk, c.f("io", "util_warn_hold"), c.f("io", "util_crit_hold")),
            ("cpu_psi", "cpu", self.r_cpu_psi, c.f("cpu", "psi_warn_hold"), c.f("cpu", "crit_hold")),
            ("cpu_load", "cpu", self.r_cpu_load, c.f("cpu", "load_warn_hold"), 0),
        ]
        self.deb = {r[0]: Debounce() for r in self.rules}
        self.space_deb = {}

    # --- memory ---
    def r_trend(self, m):
        eta = m.get("eta_s")
        if eta is None:
            return 0, ""
        rate = -(m.get("mem_slope_mb_s") or 0.0)
        if eta <= 0:
            msg = "RAM+swap headroom exhausted (available %s, still falling %.0f MB/s)" % (
                gb(m["mem_avail_mb"]), rate)
        else:
            msg = "RAM exhaustion predicted in %s (available %s, falling %.0f MB/s)" % (
                fmt_eta(eta), gb(m["mem_avail_mb"]), rate)
        if eta < self.cfg.f("trend", "crit_eta"):
            return 2, msg
        if eta < self.cfg.f("trend", "warn_eta"):
            return 1, msg
        return 0, ""

    def r_mem_psi(self, m):
        c = self.cfg
        some, full = m["psi_mem_some10"], m["psi_mem_full10"]
        msg = "memory pressure: tasks stalled %.0f%% of time (PSI some), all tasks %.0f%% (full)" % (some, full)
        if some > c.f("memory", "psi_some_crit") or full > c.f("memory", "psi_full_crit"):
            return 2, msg
        if some > c.f("memory", "psi_some_warn"):
            return 1, msg
        return 0, ""

    def r_mem_avail(self, m):
        c = self.cfg
        pct = m["mem_avail_pct"]
        if pct < c.f("memory", "avail_crit_pct"):
            return 2, "available RAM critically low: %s (%.1f%%)" % (gb(m["mem_avail_mb"]), pct)
        if pct < c.f("memory", "avail_warn_pct"):
            return 1, "available RAM below %g%%: %s (%.1f%%)" % (
                c.f("memory", "avail_warn_pct"), gb(m["mem_avail_mb"]), pct)
        return 0, ""

    def r_swap(self, m):
        c = self.cfg
        tot = m["swap_total_mb"]
        if tot <= 0:
            return 0, ""
        used_pct = 100.0 * m["swap_used_mb"] / tot
        act = m["swapin_mb_s"] + m["swapout_mb_s"]
        msg = "swap %.2f/%.2f GB used (%.0f%%), swap-in %.1f / swap-out %.1f MB/s" % (
            m["swap_used_mb"] / 1024, tot / 1024, used_pct, m["swapin_mb_s"], m["swapout_mb_s"])
        if used_pct > c.f("swap", "used_crit_pct") and m["mem_avail_pct"] < c.f("memory", "avail_warn_pct"):
            return 2, msg
        if (used_pct > c.f("swap", "used_warn_pct") and m["swapout_mb_s"] > c.f("swap", "swapout_warn_mb_s")) \
                or act > c.f("swap", "activity_warn_mb_s"):
            return 1, msg
        return 0, ""

    def r_reclaim(self, m):
        c = self.cfg
        hit = (m["refault_s"] > c.f("reclaim", "refault_warn_pages_s")
               or m["allocstall_s"] > c.f("reclaim", "allocstall_warn_s")
               or m["pgscan_direct_s"] > c.f("reclaim", "pgscan_direct_warn_pages_s")
               or m["majflt_s"] > c.f("reclaim", "majfault_warn_s"))
        if not hit:
            return 0, ""
        return 1, ("memory thrashing/reclaim: %.0f refaults/s, %.0f direct-reclaim stalls/s, "
                   "%.0f major faults/s" % (m["refault_s"], m["allocstall_s"], m["majflt_s"]))

    def r_oom(self, m):
        if m.get("oom_kills", 0) > 0:
            return 2, "kernel OOM killer fired (%d kill%s)" % (m["oom_kills"], "" if m["oom_kills"] == 1 else "s")
        return 0, ""

    # --- io ---
    def r_io_psi(self, m):
        c = self.cfg
        some, full = m["psi_io_some10"], m["psi_io_full10"]
        msg = "I/O pressure: all tasks stalled on I/O %.0f%% of time (PSI full), some %.0f%%" % (full, some)
        if full > c.f("io", "psi_full_crit"):
            return 2, msg
        if full > c.f("io", "psi_full_warn") or some > c.f("io", "psi_some_warn"):
            return 1, msg
        return 0, ""

    def r_blocked(self, m):
        c = self.cfg
        n = m["procs_blocked"]
        msg = "%d tasks blocked waiting for I/O (D-state)" % n
        if n >= c.f("io", "blocked_crit"):
            return 2, msg
        if n >= c.f("io", "blocked_warn"):
            return 1, msg
        return 0, ""

    def r_disk(self, m):
        c = self.cfg
        u, w = m["disk_util"], m["iowait_pct"]
        msg = "disk %s saturated: %.0f%% busy, iowait %.0f%%, await %.0f ms" % (
            m["disk_dev"], u, w, m["disk_await_ms"])
        if u >= c.f("io", "util_crit") and w > c.f("io", "iowait_crit"):
            return 2, msg
        if u > c.f("io", "util_warn") and w > c.f("io", "iowait_warn"):
            return 1, msg
        return 0, ""

    # --- cpu ---
    def r_cpu_psi(self, m):
        c = self.cfg
        msg = "CPU pressure: tasks waiting for CPU %.0f%% of time (PSI some, 60 s avg), load %.1f on %d CPUs" % (
            m["psi_cpu_some60"], m["load1"], self.ncpu)
        if m["psi_cpu_some10"] > c.f("cpu", "psi_some_crit") and m["load1"] > c.f("cpu", "load_crit_factor") * self.ncpu:
            return 2, msg
        if m["psi_cpu_some60"] > c.f("cpu", "psi_some_avg60_warn"):
            return 1, msg
        return 0, ""

    def r_cpu_load(self, m):
        if m["load1"] > self.cfg.f("cpu", "load_warn_factor") * self.ncpu:
            return 1, "load average %.1f on %d CPUs" % (m["load1"], self.ncpu)
        return 0, ""

    # --- space ---
    def space(self, m, now):
        c = self.cfg
        reasons = {}
        for mp, v in (m.get("fs") or {}).items():
            if not v:
                continue
            gb_rules = v["size_gb"] >= c.f("space", "gb_rules_min_size_gb")
            lvl = 0
            if v["pct"] > c.f("space", "crit_used_pct") or (gb_rules and v["free_gb"] < c.f("space", "crit_free_gb")):
                lvl = 2
            elif v["pct"] > c.f("space", "warn_used_pct") or (gb_rules and v["free_gb"] < c.f("space", "warn_free_gb")):
                lvl = 1
            if lvl:
                reasons["fs:" + mp] = (lvl, "space", "%s is %.1f%% full (%.1f GB free)" % (mp, v["pct"], v["free_gb"]))
        return (max([r[0] for r in reasons.values()] or [0]), reasons)

    def evaluate(self, m, now):
        self.trend.update(now, m)
        reasons = {}
        for key, cat, fn, wh, ch in self.rules:
            raw, msg = fn(m)
            lvl = self.deb[key].update(raw, now, wh, ch)
            if lvl:
                reasons[key] = (lvl, cat, msg)
        cats = [cat for cat in ("memory", "io", "cpu") if any(r[1] == cat for r in reasons.values())]
        if self.cfg.b("combination", "enabled") and len(cats) >= self.cfg.i("combination", "min_categories"):
            reasons["combo"] = (2, "combo", "combined pressure: " + " + ".join(CAT_NAMES[x] for x in cats))
        level = max([r[0] for r in reasons.values()] or [0])
        return level, reasons


def ordered_keys(reasons):
    def k(key):
        base = key if key in PRIORITY else ("zz" + key)
        return (-reasons[key][0], PRIORITY.index(base) if base in PRIORITY else 99, key)
    return sorted(reasons, key=k)


# --------------------------------------------------------------------------
# State machine with anti-spam logic
# --------------------------------------------------------------------------

class Channel:
    """Per-channel state machine.

    Notifies on entering WARNING, entering CRITICAL and on RECOVERY. Never
    repeats while the state is unchanged. Inside a WARNING episode, a signal
    that was not active before (e.g. the RAM-exhaustion prediction) produces
    one UPDATE notification, rate-limited to `update_interval`.
    """

    def __init__(self, name, recovery_hold, flap_guard, update_interval):
        self.name = name
        self.recovery_hold = recovery_hold
        self.flap_guard = flap_guard
        self.update_interval = update_interval
        self.state = 0
        self.below_since = None
        self.last_recovery = -1e18
        self.last_notify = -1e18
        self.last_crit_notify = -1e18
        self.ep_start = None
        self.ep_peak = 0
        self.ep_notified = False
        self.seen = set()

    def update(self, now, level, reasons):
        out = []
        active = set(reasons)
        if level > self.state:
            if self.state == 0:
                self.ep_start = now
                self.ep_peak = 0
                self.ep_notified = False
                self.seen = set()
            if level == 2:
                kind = "CRITICAL"
                notify = (now - self.last_crit_notify) >= self.flap_guard
                if notify:
                    self.last_crit_notify = now
            else:
                kind = "WARNING"
                notify = (now - self.last_recovery) >= self.flap_guard
            self.state = level
            self.ep_peak = max(self.ep_peak, level)
            self.below_since = None
            self.seen |= active
            if notify:
                self.ep_notified = True
                self.last_notify = now
            out.append((kind, notify, sorted(active)))
        elif level < self.state:
            if self.below_since is None:
                self.below_since = now
            if now - self.below_since >= self.recovery_hold:
                if level == 0:
                    out.append(("RECOVERY", self.ep_notified, []))
                    if self.ep_notified:
                        self.last_notify = now
                    self.state = 0
                    self.last_recovery = now
                else:
                    self.state = level
                    out.append(("DOWNGRADE", False, sorted(active)))
                self.below_since = None
        else:
            self.below_since = None
        if self.state == 1 and not out:
            new = active - self.seen
            if new and now - self.last_notify >= self.update_interval:
                self.seen |= new
                self.last_notify = now
                self.ep_notified = True
                out.append(("UPDATE", True, sorted(new)))
        return out


