def read_text(path):
    with open(path, "rb") as f:
        return f.read().decode("utf-8", "replace")


def read_kv(path):
    """Parse 'Key:  123 kB' style files into {key: int}."""
    out = {}
    for line in read_text(path).splitlines():
        k, _, v = line.partition(":")
        v = v.split()
        if v:
            try:
                out[k] = int(v[0])
            except ValueError:
                pass
    return out


def read_vmstat():
    out = {}
    for line in read_text("/proc/vmstat").splitlines():
        k, _, v = line.partition(" ")
        try:
            out[k] = int(v)
        except ValueError:
            pass
    return out


def read_psi():
    out = {}
    for res in ("cpu", "memory", "io"):
        d = {}
        try:
            for line in read_text("/proc/pressure/" + res).splitlines():
                parts = line.split()
                vals = dict(p.split("=") for p in parts[1:])
                d[parts[0]] = (float(vals["avg10"]), float(vals["avg60"]),
                               float(vals["avg300"]), int(vals["total"]))
        except (OSError, KeyError, ValueError, IndexError):
            pass
        out[res] = d
    return out


def gb(mb):
    return "%.1f GB" % (mb / 1024.0)


def fmt_eta(s):
    if s is None:
        return "-"
    if s < 120:
        return "~%d s" % max(0, int(round(s / 5.0) * 5))
    return "~%d min" % int(round(s / 60.0))


def fmt_dur(s):
    s = int(s)
    if s < 60:
        return "%d s" % s
    if s < 3600:
        return "%d min %d s" % (s // 60, s % 60)
    return "%d h %d min" % (s // 3600, (s % 3600) // 60)


def fmt_num(v):
    if v is None:
        return ""
    if isinstance(v, float):
        s = "%.2f" % v
        return s.rstrip("0").rstrip(".") if "." in s else s
    return str(v)


def fs_key(mp):
    return "root" if mp == "/" else mp.strip("/").replace("/", "_")


def now_str(ts=None):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts if ts is not None else time.time()))


def detect_disks():
    out = []
    for name in sorted(os.listdir("/sys/block")):
        if name.startswith(("loop", "ram", "zram", "sr", "fd", "dm-", "md")):
            continue
        if os.path.exists("/sys/block/%s/device" % name):
            out.append(name)
    return out


# --------------------------------------------------------------------------
# Metric collection (pure /proc + /sys reads, no forking)
# --------------------------------------------------------------------------

class Collector:
    def __init__(self, cfg):
        self.cfg = cfg
        self.ncpu = os.cpu_count() or 1
        d = cfg.s("general", "disks")
        self.disks = detect_disks() if d == "auto" else cfg.lst("general", "disks")
        self.filesystems = cfg.lst("space", "filesystems")
        self.prev = None
        self.fs_last = {}
        self.fs_checked = -1e9

    def _raw(self):
        r = {"t": time.monotonic(), "wall": time.time()}
        r["mem"] = read_kv("/proc/meminfo")
        r["vm"] = read_vmstat()
        for line in read_text("/proc/stat").splitlines():
            if line.startswith("cpu "):
                r["cpu"] = [int(x) for x in line.split()[1:]]
            elif line.startswith("procs_running"):
                r["procs_running"] = int(line.split()[1])
            elif line.startswith("procs_blocked"):
                r["procs_blocked"] = int(line.split()[1])
        la = read_text("/proc/loadavg").split()
        r["load"] = (float(la[0]), float(la[1]), float(la[2]))
        r["threads"] = int(la[3].split("/")[1])
        r["psi"] = read_psi()
        disk = {}
        for line in read_text("/proc/diskstats").splitlines():
            p = line.split()
            if len(p) >= 14 and p[2] in self.disks:
                disk[p[2]] = [int(x) for x in p[3:14]]
        r["disk"] = disk
        return r

    def check_fs(self, m, force=False):
        now = time.monotonic()
        if force or now - self.fs_checked >= self.cfg.f("space", "check_interval"):
            self.fs_checked = now
            for mp in self.filesystems:
                try:
                    st = os.statvfs(mp)
                except OSError:
                    self.fs_last[mp] = None
                    continue
                used = (st.f_blocks - st.f_bfree) * st.f_frsize
                avail = st.f_bavail * st.f_frsize
                size = st.f_blocks * st.f_frsize
                pct = 100.0 * used / (used + avail) if used + avail else 0.0
                self.fs_last[mp] = {"pct": pct, "free_gb": avail / 1024.0 ** 3,
                                    "size_gb": size / 1024.0 ** 3}
        m["fs"] = dict(self.fs_last)
        for mp in self.filesystems:
            v = self.fs_last.get(mp)
            k = fs_key(mp)
            m["fs_%s_pct" % k] = round(v["pct"], 2) if v else None
            m["fs_%s_free_gb" % k] = round(v["free_gb"], 2) if v else None

    def sample(self):
        """Return a metrics dict, or None on the very first call (no deltas yet)."""
        r = self._raw()
        p, self.prev = self.prev, r
        if p is None:
            return None
        dt = max(1e-3, r["t"] - p["t"])
        mem = r["mem"]
        m = {"epoch": r["wall"], "interval_s": dt, "ncpu": self.ncpu}
        kb = 1.0 / 1024
        total = mem.get("MemTotal", 1) * kb
        avail = mem.get("MemAvailable", 0) * kb
        shmem = mem.get("Shmem", 0) * kb
        m.update({
            "mem_total_mb": total,
            "mem_avail_mb": avail,
            "mem_avail_pct": 100.0 * avail / total,
            "mem_free_mb": mem.get("MemFree", 0) * kb,
            "anon_mb": mem.get("AnonPages", 0) * kb,
            "shmem_mb": shmem,
            "cache_mb": (mem.get("Cached", 0) + mem.get("Buffers", 0)) * kb - shmem,
            "kernel_mb": (mem.get("Slab", 0) + mem.get("KernelStack", 0) + mem.get("PageTables", 0)) * kb,
            "slab_unrecl_mb": mem.get("SUnreclaim", 0) * kb,
            "dirty_mb": mem.get("Dirty", 0) * kb,
            "writeback_mb": mem.get("Writeback", 0) * kb,
            "swap_total_mb": mem.get("SwapTotal", 0) * kb,
            "swap_used_mb": (mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)) * kb,
        })
        vm, pvm = r["vm"], p["vm"]

        def rate(*keys):
            return sum(vm.get(k, 0) - pvm.get(k, 0) for k in keys) / dt

        refault_keys = [k for k in vm if k.startswith("workingset_refault")]
        stall_keys = [k for k in vm if k.startswith("allocstall")]
        m["swapin_mb_s"] = rate("pswpin") * PAGE / MB
        m["swapout_mb_s"] = rate("pswpout") * PAGE / MB
        m["majflt_s"] = rate("pgmajfault")
        m["refault_s"] = rate(*refault_keys)
        m["allocstall_s"] = rate(*stall_keys)
        m["pgscan_direct_s"] = rate("pgscan_direct")
        m["oom_kills"] = vm.get("oom_kill", 0) - pvm.get("oom_kill", 0)

        # PSI
        for res, short in (("memory", "mem"), ("io", "io"), ("cpu", "cpu")):
            cur, prv = r["psi"].get(res, {}), p["psi"].get(res, {})
            for kind in ("some", "full"):
                v = cur.get(kind)
                m["psi_%s_%s10" % (short, kind)] = v[0] if v else 0.0
                m["psi_%s_%s60" % (short, kind)] = v[1] if v else 0.0
                pv = prv.get(kind)
                m["psi_%s_%s_int" % (short, kind)] = (
                    min(100.0, (v[3] - pv[3]) / (dt * 1e6) * 100.0) if v and pv else 0.0)

        # CPU
        c, pc = r["cpu"], p["cpu"]
        d = [a - b for a, b in zip(c, pc)]
        tot = sum(d[:8]) or 1
        m["cpu_pct"] = 100.0 * (tot - d[3] - d[4]) / tot
        m["iowait_pct"] = 100.0 * d[4] / tot
        m["steal_pct"] = 100.0 * d[7] / tot if len(d) > 7 else 0.0
        m["load1"], m["load5"], m["load15"] = r["load"]
        m["procs_running"] = r.get("procs_running", 0)
        m["procs_blocked"] = r.get("procs_blocked", 0)
        m["threads_total"] = r["threads"]

        # Disks: fields (0-based after name) reads,rmerged,rsect,rticks,writes,wmerged,wsect,wticks,inflight,ioticks,weighted
        best = None
        rsum = wsum = 0.0
        per = {}
        for name, v in r["disk"].items():
            pv = p["disk"].get(name)
            if not pv:
                continue
            dd = [a - b for a, b in zip(v, pv)]
            util = min(100.0, dd[9] / (dt * 1000.0) * 100.0)
            ios = dd[0] + dd[4]
            await_ms = (dd[3] + dd[7]) / ios if ios > 0 else 0.0
            rmb = dd[2] * 512.0 / MB / dt
            wmb = dd[6] * 512.0 / MB / dt
            rsum += rmb
            wsum += wmb
            per[name] = {"util": util, "r_mb_s": rmb, "w_mb_s": wmb, "await_ms": await_ms,
                         "inflight": v[8]}
            if best is None or util > per[best]["util"]:
                best = name
        m["disks"] = per
        m["disk_dev"] = best or ""
        m["disk_util"] = per[best]["util"] if best else 0.0
        m["disk_await_ms"] = per[best]["await_ms"] if best else 0.0
        m["disk_r_mb_s"] = rsum
        m["disk_w_mb_s"] = wsum
        self.check_fs(m)
        return m


# --------------------------------------------------------------------------
# Trend prediction
# --------------------------------------------------------------------------

def _median(v):
    v = sorted(v)
    n = len(v)
    if n == 0:
        return 0.0
    return v[n // 2] if n % 2 else 0.5 * (v[n // 2 - 1] + v[n // 2])


class Trend:
    """Robust RAM-exhaustion prediction.

    headroom = MemAvailable + SwapFree - floor. The decline rate is the
    Theil-Sen estimator (median of all pairwise slopes) over `window` seconds:
    a short allocation spike only affects a minority of the pairs and does not
    move the median, while a sustained decline does.
    """

    def __init__(self, cfg):
        self.cfg = cfg
        self.buf = collections.deque()

    def update(self, now, m):
        c = self.cfg
        window = c.f("trend", "window")
        floor = m["mem_total_mb"] * c.f("trend", "floor_pct") / 100.0
        swap_free = max(0.0, m["swap_total_mb"] - m["swap_used_mb"])
        head = m["mem_avail_mb"] + swap_free - floor
        self.buf.append((now, head))
        while self.buf and now - self.buf[0][0] > window:
            self.buf.popleft()
        m["headroom_mb"] = head
        m["mem_slope_mb_s"] = None
        m["eta_s"] = None
        pts = list(self.buf)
        if len(pts) < 4 or now - pts[0][0] < 0.66 * window:
            return
        slopes = []
        for i in range(len(pts)):
            t1, h1 = pts[i]
            for j in range(i + 1, len(pts)):
                t2, h2 = pts[j]
                if t2 > t1:
                    slopes.append((h2 - h1) / (t2 - t1))
        slope = _median(slopes)
        m["mem_slope_mb_s"] = slope
        if not c.b("trend", "enabled"):
            return
        if m["mem_avail_pct"] >= c.f("trend", "arm_below_avail_pct"):
            return
        rate = -slope
        if rate < c.f("trend", "min_rate_mb_s"):
            return
        recent = _median([h for _, h in pts[-3:]])
        m["eta_s"] = max(0.0, recent / rate)


