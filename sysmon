_uid_cache = {}


def uname(uid):
    if uid not in _uid_cache:
        try:
            _uid_cache[uid] = pwd.getpwuid(uid).pw_name
        except KeyError:
            _uid_cache[uid] = str(uid)
    return _uid_cache[uid]


def scan_processes(full=True):
    procs = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        pid = int(name)
        base = "/proc/" + name
        try:
            s = read_text(base + "/stat")
            l, r = s.find("("), s.rfind(")")
            rest = s[r + 2:].split()
            p = {"pid": pid, "comm": s[l + 1:r], "state": rest[0], "ppid": int(rest[1]),
                 "cpu": int(rest[11]) + int(rest[12]), "threads": int(rest[17]),
                 "start": int(rest[19]), "rss_kb": int(rest[21]) * PAGE // 1024}
        except (OSError, ValueError, IndexError):
            continue
        try:
            for line in read_text(base + "/io").splitlines():
                k, _, v = line.partition(": ")
                if k in ("read_bytes", "write_bytes"):
                    p[k] = int(v)
        except OSError:
            pass
        if full:
            try:
                st = read_kv(base + "/status")
                p["anon_kb"] = st.get("RssAnon", 0)
                p["shmem_kb"] = st.get("RssShmem", 0)
                p["swap_kb"] = st.get("VmSwap", 0)
                with open(base + "/status") as f:
                    for line in f:
                        if line.startswith("Uid:"):
                            p["user"] = uname(int(line.split()[1]))
                            break
            except (OSError, ValueError):
                pass
        procs[pid] = p
    return procs


def d_state_tasks(procs, limit=60):
    out = []
    for pid, p in procs.items():
        tids = []
        if p.get("threads", 1) > 1:
            try:
                tids = [int(t) for t in os.listdir("/proc/%d/task" % pid)]
            except OSError:
                tids = []
        else:
            tids = [pid]
        for tid in tids:
            try:
                s = read_text("/proc/%d/task/%d/stat" % (pid, tid))
            except OSError:
                continue
            r = s.rfind(")")
            if s[r + 2:r + 3] != "D":
                continue
            try:
                wchan = read_text("/proc/%d/task/%d/wchan" % (pid, tid)).strip()
            except OSError:
                wchan = "?"
            out.append((pid, tid, s[s.find("(") + 1:r], p.get("comm", "?"), wchan))
            if len(out) >= limit:
                return out
    return out


_cmdline_busy = threading.Event()


def read_cmdlines(pids, timeout=1.0):
    """Read cmdlines in a helper thread: /proc/PID/cmdline takes the target's
    mmap lock and can block during memory thrashing, so never do it inline."""
    res = {}
    if _cmdline_busy.is_set():
        return res

    def worker():
        _cmdline_busy.set()
        try:
            for pid in pids:
                try:
                    res[pid] = read_text("/proc/%d/cmdline" % pid).replace("\0", " ").strip()[:160]
                except OSError:
                    pass
        finally:
            _cmdline_busy.clear()

    t = threading.Thread(target=worker, daemon=True)
    t.start()
    t.join(timeout)
    return dict(res)


def tmpfs_usage():
    out = []
    try:
        for line in read_text("/proc/mounts").splitlines():
            p = line.split()
            if len(p) > 2 and p[2] in ("tmpfs", "ramfs"):
                try:
                    st = os.statvfs(p[1])
                except OSError:
                    continue
                used = (st.f_blocks - st.f_bfree) * st.f_frsize
                if used > 16 * MB:
                    out.append((used, p[1]))
    except OSError:
        pass
    return sorted(out, reverse=True)


def sysv_shm():
    rows = []
    try:
        lines = read_text("/proc/sysvipc/shm").splitlines()
        hdr = lines[0].split()
        for line in lines[1:]:
            v = dict(zip(hdr, line.split()))
            rows.append((int(v.get("rss", v.get("size", 0))), int(v.get("size", 0)), int(v.get("cpid", 0)),
                         int(v.get("nattch", 0))))
    except (OSError, IndexError, ValueError):
        pass
    return rows


def top_apps(procs, n=5):
    agg = collections.defaultdict(int)
    for p in procs.values():
        agg[p["comm"]] += p.get("anon_kb", p["rss_kb"]) + p.get("swap_kb", 0)
    return sorted(agg.items(), key=lambda x: -x[1])[:n]


